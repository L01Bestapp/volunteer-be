# ========================================
# VOLUNTEER MANAGEMENT SYSTEM
# Environment Variables Template
# ========================================

# Deployment Environment (prod/dev/test)
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
BASE_URL_WEBSITE=https://your-app.onrender.com

# ========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ========================================
# On Render, these are usually provided by the Postgres Service
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=volunteer_db
POSTGRES_USER=volunteer
POSTGRES_PASSWORD=your_secure_db_password

# ========================================
# JWT & SECURITY CONFIGURATION (CRITICAL)
# ========================================
# Generate new RSA 2048-bit keys:
# openssl genrsa -out privateKey.pem 2048
# openssl rsa -in privateKey.pem -pubout -out publicKey.pem

# Paste the ENTIRE content of privateKey.pem (including -----BEGIN... and -----END...)
JWT_PRIVATE_KEY_CONTENT=-----BEGIN PRIVATE KEY-----
MIIEv...content...
-----END PRIVATE KEY-----

# Paste the ENTIRE content of publicKey.pem
JWT_PUBLIC_KEY_CONTENT=-----BEGIN PUBLIC KEY-----
MIIBI...content...
-----END PUBLIC KEY-----

JWT_KEY_ID=ctxh-key
EXP_TOKEN=604800           # 7 days
EXP_REFRESH_TOKEN=2592000  # 30 days

# Admin Initial Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_secret_password

# ========================================
# FIREBASE CONFIGURATION
# ========================================
# Firebase Admin SDK for push notifications
# Paste the content of your firebase-service-account.json here.
# Render supports multi-line values, or you can minify it to a single line.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# ========================================
# GOOGLE OAUTH 2.0 CONFIGURATION
# ========================================
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Optional: Mobile Client IDs if verification is strictly enforced
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=

# ========================================
# MAIL CONFIGURATION (Gmail)
# ========================================
# Gmail App Password: https://myaccount.google.com/apppasswords
MAIL_SENDER_USERNAME=your-email@gmail.com
MAIL_SENDER_PASSWORD=your-16-char-app-password

# ========================================
# CLOUDINARY CONFIGURATION
# ========================================
# Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret