# ========================================
# VOLUNTEER MANAGEMENT SYSTEM
# Environment Variables Template
# ========================================
# Sử dụng file này làm template để set environment variables trên Render.
# Các biến được đánh dấu [REQUIRED] là BẮT BUỘC cho production.
# Các biến được đánh dấu [OPTIONAL] có thể bỏ trống nếu không dùng feature đó.

# ========================================
# 1. DEPLOYMENT & SERVER CONFIGURATION
# ========================================
# [REQUIRED] Profile môi trường (prod/dev/test)
SPRING_PROFILES_ACTIVE=prod

# [OPTIONAL] Cổng server (default: 8080, Render tự động map)
SERVER_PORT=8080

# [REQUIRED] Base URL của website (dùng cho OAuth redirect, email links, etc.)
# Format: https://your-service-name.onrender.com (không có trailing slash)
BASE_URL_WEBSITE=https://volunteer-api.onrender.com

# ========================================
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ========================================
# [REQUIRED] Render tự động cung cấp các giá trị này khi bạn link PostgreSQL service
# Trên Render Dashboard: Sử dụng INTERNAL DATABASE URL (nhanh hơn External)
POSTGRES_HOST=dpg-xxxxx.singapore-postgres.render.com
POSTGRES_PORT=5432
POSTGRES_DB=volunteer_db
POSTGRES_USER=volunteer
POSTGRES_PASSWORD=xxxxxxxxxxxxxxxxxxxx

# ========================================
# 3. JWT & SECURITY CONFIGURATION
# ========================================
# [REQUIRED] RSA Keys cho JWT signing (CRITICAL SECURITY)
#
# Cách tạo RSA key pair (2048-bit):
#   openssl genrsa -out privateKey.pem 2048
#   openssl rsa -in privateKey.pem -pubout -out publicKey.pem
#
# QUAN TRỌNG:
# - Copy TOÀN BỘ nội dung của file (bao gồm -----BEGIN... và -----END...)
# - Giữ nguyên các line breaks (xuống dòng)
# - Trên Render: Paste trực tiếp vào ô Environment Variable (hỗ trợ multiline)
# - TUYỆT ĐỐI KHÔNG commit các keys này vào Git

JWT_PRIVATE_KEY_CONTENT=-----BEGIN PRIVATE KEY-----
MIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...
... (copy toàn bộ content) ...
-----END PRIVATE KEY-----

JWT_PUBLIC_KEY_CONTENT=-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAr4w...
... (copy toàn bộ content) ...
-----END PUBLIC KEY-----

# [OPTIONAL] Key ID cho JWT (dùng khi rotate keys)
JWT_KEY_ID=ctxh-key

# [OPTIONAL] Token expiration times (seconds)
EXP_TOKEN=604800           # Access token: 7 days
EXP_REFRESH_TOKEN=2592000  # Refresh token: 30 days

# ========================================
# 4. ADMIN CREDENTIALS (Initial Setup)
# ========================================
# [OPTIONAL] Credentials cho admin account (tự động tạo lần đầu khởi động)
# Nếu không set, sẽ dùng default: admin/admin (KHÔNG AN TOÀN cho production)
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=YourSecurePasswordHere123!

# ========================================
# 5. GOOGLE OAUTH 2.0 CONFIGURATION
# ========================================
# [REQUIRED] Google OAuth 2.0 credentials cho "Login with Google"
#
# Lấy từ: https://console.cloud.google.com/apis/credentials
#
# Setup:
# 1. Tạo OAuth 2.0 Client ID (Web application)
# 2. Authorized redirect URIs: https://your-domain.com/login/oauth2/code/google
# 3. Copy Client ID và Client Secret
#
# Redirect URI được config trong application-prod.yml:
#   redirect-uri: ${BASE_URL_WEBSITE}/login/oauth2/code/google

GOOGLE_CLIENT_ID=123456789-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# [OPTIONAL] Google OAuth Client IDs cho mobile platforms (nếu có mobile app)
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=

# ========================================
# 6. FIREBASE CONFIGURATION (Push Notifications)
# ========================================
# [OPTIONAL] Firebase Admin SDK credentials cho FCM push notifications
#
# Lấy từ: Firebase Console > Project Settings > Service Accounts > Generate new private key
#
# Format: Toàn bộ JSON content từ firebase-service-account.json
# Có thể minify thành 1 dòng hoặc giữ nguyên multi-line (Render hỗ trợ cả 2)
#
# LƯU Ý: Nếu không set, FCM notifications sẽ không hoạt động nhưng app vẫn chạy bình thường
#        (sẽ có log warning: "Firebase credentials not found in environment variables")

FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# ========================================
# 7. MAIL CONFIGURATION (Email Sending)
# ========================================
# [REQUIRED] Gmail SMTP credentials cho gửi email (password reset, notifications, etc.)
#
# Lấy App Password từ: https://myaccount.google.com/apppasswords
# Yêu cầu: Phải bật 2-Factor Authentication trên Google Account
#
# SMTP config mặc định (trong application-prod.yml):
#   host: smtp.gmail.com
#   port: 587
#   TLS: enabled

MAIL_SENDER_USERNAME=your-email@gmail.com
MAIL_SENDER_PASSWORD=abcd efgh ijkl mnop  # 16-character App Password (có thể có spaces)

# ========================================
# 8. CLOUDINARY CONFIGURATION (Image Upload)
# ========================================
# [REQUIRED] Cloudinary credentials cho upload/manage images
#
# Lấy từ: https://cloudinary.com/console
# Dashboard > Account Details > API Keys
#
# Sử dụng trong:
# - Upload user avatars (AuthServiceImpl.java:712)
# - Upload activity images (ActivityServiceImpl.java)

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz123456

# ========================================
# TỔNG KẾT: Priority Level
# ========================================
#
# CRITICAL (App không chạy nếu thiếu):
# - JWT_PRIVATE_KEY_CONTENT
# - JWT_PUBLIC_KEY_CONTENT
# - POSTGRES_* (all 5 variables)
# - BASE_URL_WEBSITE
#
# HIGH PRIORITY (Core features không hoạt động):
# - GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET (Login with Google)
# - MAIL_SENDER_* (Password reset, email notifications)
# - CLOUDINARY_* (Image upload)
#
# MEDIUM PRIORITY (Optional features):
# - FIREBASE_SERVICE_ACCOUNT_JSON (Push notifications)
# - ADMIN_USERNAME & ADMIN_PASSWORD (Admin account)
#
# LOW PRIORITY (Có default values):
# - SERVER_PORT, JWT_KEY_ID, EXP_TOKEN, EXP_REFRESH_TOKEN
# - GOOGLE_CLIENT_ID_ANDROID, GOOGLE_CLIENT_ID_IOS
# ========================================